{
  "schemaVersion": 1,
  "id": "afkfarmutils",
  "version": "${version}",
  "name": "AFKFarmUtils",
  "description": "A mod that adds some useful features for AFK farms.",
  "authors": [
    "4ronse <https://github.com/4ronse>"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/afkfarmutils/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.ronse.afkfarmutils.AFKFarmUtils"
    ],
    "modmenu": [
      "dev.ronse.afkfarmutils.AFKModMenuImpl"
    ]
  },
  "mixins": [
    "afkfarmutils.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "github": "https://gitub.com/4ronse/AFKFarmUtils"
      },
      "update_checker": false
    }
  }
}
